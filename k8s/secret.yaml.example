# Copy this file to secret.yaml, fill in real values, and NEVER commit secret.yaml to version control.
# To generate a Django secret key:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
apiVersion: v1
kind: Secret
metadata:
  name: edusystem-secret
  namespace: edusystem
type: Opaque
stringData:
  DJANGO_SECRET_KEY: "change-me-to-a-long-random-secret-key"
  DB_PASSWORD: "change-me-to-a-strong-password"
